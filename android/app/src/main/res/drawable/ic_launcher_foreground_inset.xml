<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon foreground with the artwork pulled inside the 66dp safe zone.
  The source PNG is drawn edge to edge, so launchers cropped the mark at the
  corners (the logo looked cut off at the top right). An 18% inset keeps the
  whole mark visible whatever mask the launcher applies.
-->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@mipmap/ic_launcher_foreground"
    android:insetLeft="18%"
    android:insetTop="18%"
    android:insetRight="18%"
    android:insetBottom="18%" />

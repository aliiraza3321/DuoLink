# Build outputs
node_modules/
/build/
dist/
coverage/
.DS_Store
*.log
.env*
!.env.example

# Android build artifacts
android/.gradle/
android/build/
android/app/build/
android/local.properties
*.apk
*.aab
*.ap_
*.dex

# Signing material - must never be committed
android/keystore.properties
android/keystore/
*.jks
*.keystore
keystore.properties

# Installer artwork + NSIS script live in desktop/build and are tracked
# (the root /build/ rule above is anchored so it does not swallow them).

# Temp / scratch
*.bmp.tmp
screenshots/*.png

# Large promo media (not needed to build or run)
*.mp4
media/
video-src/
